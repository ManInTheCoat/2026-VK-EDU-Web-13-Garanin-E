SECRET_KEY=key
DEBUG=True
ALLOWED_HOSTS=*

DB_NAME=niceanswer_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

POSTGRES_DB=niceanswer_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Настройки Redis, Celery и Celery Beat
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_BROKER_DB=1
REDIS_BEAT_DB=2

# Настройки Centrifugo
CENTRIFUGO_API_KEY=your_api_key_here
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=your_hmac_secret_key_here
CENTRIFUGO_URL=http://127.0.0.1:8001/api
CENTRIFUGO_WS_URL=ws://127.0.0.1:8001/connection/websocket

# Настройки Email
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@niceanswer.local
